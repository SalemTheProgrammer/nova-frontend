# Base URL for the backend API. In dev, Vite proxies /api to
# localhost:8000, so the defaults work out of the box.
VITE_API_BASE=/api/v1

# API key sent as the X-API-Key header (must match the backend's API_KEYS).
# It is compiled into the public JS bundle: it is not a secret.
VITE_API_KEY=dev-local-key

